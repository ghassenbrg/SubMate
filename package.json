{
  "name": "submate",
  "version": "0.1.1",
  "description": "Private, synchronized on-device subtitle translation for Netflix, TVer and Prime Video in Chrome.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghassenbrg/SubMate.git"
  },
  "bugs": {
    "url": "https://github.com/ghassenbrg/SubMate/issues"
  },
  "homepage": "https://ghassenbrg.github.io/SubMate/",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "chrome-extension",
    "netflix",
    "subtitles",
    "translation",
    "manifest-v3",
    "tver",
    "hls",
    "webvtt",
    "multi-platform"
  ],
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "node scripts/build.mjs chrome",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:cloud": "node scripts/cloud-smoke.mjs",
    "coverage": "vitest run --coverage",
    "validate:chrome": "node scripts/validate-chrome-build.mjs",
    "validate:website": "node scripts/validate-website.mjs",
    "validate": "npm run check && npm run test && npm run build:chrome && npm run validate:chrome",
    "pack:chrome": "npm run build:chrome && npm run validate:chrome && node scripts/package-chrome.mjs",
    "release:verify": "node scripts/verify-release-tag.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.6",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
